      "targets": [
        {
          "expr": "100 * sum(rate(lab13_chat_errors_total{route=\"/chat\"}[5m])) / clamp_min(sum(rate(lab13_chat_requests_total{route=\"/chat\"}[5m])), 0.000001)",
