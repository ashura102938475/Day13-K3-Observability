          "refId": "A"
        },
        {
          "expr": "100 * sum by (error_type) (rate(lab13_chat_errors_total{route=\"/chat\"}[5m])) / scalar(clamp_min(sum(rate(lab13_chat_requests_total{route=\"/chat\"}[5m])), 0.000001))",
          "legendFormat": "{{error_type}}",
          "refId": "B"
        }
